digraph G {
graph [rankdir=TB, bgcolor="#F8FAFC", pad=0.35, nodesep=0.32, ranksep=0.35, fontname="PingFang SC", fontsize=25, fontcolor="#0F172A", labelloc=t, label="05 · grade_response() 教学判分\n先确认答案位置和格式，再比较数值"];
node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=17, fontcolor="#0F172A", penwidth=1.4, margin="0.18,0.12"];
edge [color="#64748B", penwidth=1.4, arrowsize=0.7, fontname="PingFang SC", fontsize=14, fontcolor="#475569"];
a [label="输入：response（已生成的文本）\nexpected（参考答案字符串）", shape=box, fillcolor="#E0F2FE", color="#0284C7"];
b [label="包含 </think>？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
c [label="只取最后一个 </think> 后的文字\n从右侧找最后一个 \\boxed{", shape=box, fillcolor="#FFFFFF", color="#CBD5E1"];
d [label="找到答案框？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
e [label="逐字符维护花括号深度 depth\n抽取框内内容，检查括号是否配对", shape=box, fillcolor="#FFFFFF", color="#CBD5E1"];
f [label="depth 回到 0（答案框闭合）？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
g [label="predicted = 框内内容去除首尾空白\n预测与参考均符合整数 / 小数 / 分数字面格式？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
h [label="用 Fraction 转换并精确比较\n转换是否成功？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
i [label="status=checked\ncorrect = 数值是否相等（True 或 False）\nanswer = predicted", shape=box, fillcolor="#DCFCE7", color="#16A34A"];
r1 [label="missing_thinking_end", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
r2 [label="missing_boxed_answer", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
r3 [label="unfinished_box", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
r4 [label="unsupported_expression", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
r5 [label="invalid_numeric_answer", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
r [label="以上复核分支均返回\nstatus=needs_review；correct=None\n未能判定，不等于已判错", shape=box, fillcolor="#F1F5F9", color="#64748B"];
n [label="只返回判分字典，不生成、不写文件、不调用外部裁判\n这是教学检查器，不是正式 MATH500 评估器", shape=box, fillcolor="#F1F5F9", color="#64748B"];
a -> b [label=""];
b -> r1 [label="否"];
b -> c [label="是"];
c -> d [label=""];
d -> r2 [label="否"];
d -> e [label="是"];
e -> f [label=""];
f -> r3 [label="否"];
f -> g [label="是"];
g -> r4 [label="否"];
g -> h [label="是"];
h -> r5 [label="抛出转换异常"];
h -> i [label="成功"];
r1 -> r [label=""];
r2 -> r [label=""];
r3 -> r [label=""];
r4 -> r [label=""];
r5 -> r [label=""];
i -> n [label=""];
r -> n [label=""];
}

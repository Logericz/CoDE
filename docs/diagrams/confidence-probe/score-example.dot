digraph G {
graph [rankdir=TB, bgcolor="#F8FAFC", pad=0.35, nodesep=0.32, ranksep=0.35, fontname="PingFang SC", fontsize=25, fontcolor="#0F172A", labelloc=t, label="保存的概率 ≠ 最终参加评分的概率\nmethod=0 的源码算例（纯教学，未运行模型）"];
node [shape=box, style="rounded,filled", fontname="PingFang SC", fontsize=17, fontcolor="#0F172A", penwidth=1.4, margin="0.18,0.12"];
edge [color="#64748B", penwidth=1.4, arrowsize=0.7, fontname="PingFang SC", fontsize=14, fontcolor="#475569"];
a [label="假设依次选出三个token：A、B、停止token\n对应概率：p1=0.70，p2=0.81，p3=0.64", shape=box, fillcolor="#E0F2FE", color="#0284C7"];
b [label="保存路径\ntoken_probs 完整保存 [0.70, 0.81, 0.64]", shape=box, fillcolor="#FFFFFF", color="#CBD5E1"];
c [label="累计路径\n第1步：S=0（首token未加入）\n第2步：S=log(0.81)\n第3步：S=log(0.81)+log(0.64)", shape=box, fillcolor="#FFFFFF", color="#CBD5E1"];
d [label="循环后：无论停止原因，减去最后概率的log\n分子 S − log(p3) = log(0.81)\n分母 n − 1 = 2", shape=box, fillcolor="#EDE9FE", color="#8B5CF6"];
e [label="返回分数 exp(log(0.81)/2) = 0.90\n实际保留1个概率项，但分母是2\n不能解释成保留项的普通几何平均", shape=box, fillcolor="#DCFCE7", color="#16A34A"];
f [label="继续看短试答边界（method=0）", shape=box, fillcolor="#FFFFFF", color="#CBD5E1"];
g [label="仅生成1个token\n分母 n−1 = 0\np1在(0,1)时可能为inf；p1=1时为NaN", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
h [label="仅生成2个token，且概率为正\n分子 log(p2)−log(p2) = 0\n分数 exp(0/1) = 1，不代表答案可靠", shape=box, fillcolor="#FEE2E2", color="#DC2626"];
i [label="教学封装的 _guard_probe()\n先记录试答，再拒绝 ≤2 token 的结果\n也拒绝非有限值等异常，保留诊断", shape=box, fillcolor="#F1F5F9", color="#64748B"];
j [label="源码行为说明：末token在达到步数上限时\n也会被减去，并不保证它是停止token\n以上分数不是答案正确率，也不是GPU实验结果", shape=box, fillcolor="#F1F5F9", color="#64748B"];
a -> b [label="所有概率都保存"];
a -> c [label="部分概率参加计算"];
c -> d [label=""];
d -> e [label=""];
b -> e [label="对照"];
e -> f [label=""];
f -> g [label="n=1"];
f -> h [label="n=2"];
g -> i [label=""];
h -> i [label=""];
i -> j [label=""];
}

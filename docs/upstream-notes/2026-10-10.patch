+# 计算当前推理步骤的有效 DEER 阈值，逐步从 ramp_min 增加到 ramp_max
+def compute_ramping_deer_threshold(
+    step_index: int,    # 当前步骤编号（第几个检查点）
+    ramp_steps: int,    # 阈值从起始值 ramp_min 增加到最大值 ramp_max 所需的总步数；人为设置的阈值
+    ramp_min: float,    # 阈值的起始值  
+    ramp_max: float     # 阈值的最大值
+) -> float:             # 返回一个浮点数，即当前步骤实际使用的阈值
 	"""Compute the effective DEER threshold at a given reasoning step, ramping from ramp_min to full_threshold."""
-	alpha = min(1.0, step_index / ramp_steps) if ramp_steps > 0 else 1.0
+    
+    # 计算变化进度 alpha：表示阈值变化完成了多少
+    # 1. ramp_steps > 0：用“当前步骤 / 总变化步数”计算进度
+    # 2. min(1.0, ...)：进度最多为 1，即达到最终阈值后不再继续变化
+    # 3. ramp_steps <= 0：直接将进度设为 1，立即使用最终阈值
+	alpha = min(1.0, step_index / ramp_steps) if ramp_steps > 0 else 1.0    
+    # 当前阈值 = 起始阈值 + (最大阈值 - 起始阈值) * 进度
 	return ramp_min + (ramp_max - ramp_min) * alpha
 
 
